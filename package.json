{
  "name": "camcompare",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "tsx scripts/check-catalog.ts && tsx scripts/build-public-data.ts && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "test": "node --import tsx --test tests/*.test.ts",
    "catalog:check": "tsx scripts/check-catalog.ts",
    "thumbs:fetch": "tsx scripts/fetch-thumbnails.ts",
    "wikidata:crosscheck": "tsx scripts/crosscheck-wikidata.ts",
    "import:prices": "tsx scripts/import-prices.ts",
    "data:public": "tsx scripts/build-public-data.ts",
    "thumbs:sheet": "tsx scripts/thumb-sheet.ts",
    "thumbs:reject": "tsx scripts/reject-thumb.ts"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "marked": "12.0.2",
    "next": "^14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "postcss": "^8.5.15",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.6",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  }
}
