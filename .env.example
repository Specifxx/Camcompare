# Canonical site URL (no trailing slash). Sitemap, canonical tags and JSON-LD use it.
NEXT_PUBLIC_SITE_URL=

# --- Affiliate ids (render time: set on Vercel) ---------------------------
# Amazon Associates store id, e.g. camcompare-20
AMAZON_ASSOCIATE_TAG=
# eBay Partner Network campaign id (make a NEW campaign for CamCompare so its
# earnings are reported apart from RiftCompare's)
EBAY_AFFILIATE_CAMPAIGN=
# One deep-link template per network retailer, with {url} and optional {subid}:
#   Impact: https://<brand>.sjv.io/c/<pub>/<ad>/<campaign>?u={url}&subId1={subid}
#   CJ:     https://www.anrdoezrs.net/click-<pid>-<aid>?url={url}&sid={subid}
#   Awin:   https://www.awin1.com/cread.php?awinmid=<mid>&awinaffid=<id>&clickref={subid}&ued={url}
AFFILIATE_DEEPLINK_BH=
AFFILIATE_DEEPLINK_ADORAMA=
AFFILIATE_DEEPLINK_BESTBUY=
AFFILIATE_DEEPLINK_MPB=
AFFILIATE_DEEPLINK_KEH=

# --- Price import (GitHub Actions secrets for refresh-prices.yml) ----------
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# Amazon Creators API (Associates Central > Tools > Creators API). NA token endpoint by default.
AMAZON_CREATORS_CLIENT_ID=
AMAZON_CREATORS_CLIENT_SECRET=
# AMAZON_CREATORS_TOKEN_URL=https://api.amazon.com/auth/o2/token
# Product feed URLs from each affiliate network (CSV/TSV/Google XML, .gz ok)
FEED_URL_BH=
FEED_URL_ADORAMA=
FEED_URL_BESTBUY=
FEED_URL_MPB=
FEED_URL_KEH=
