# CamCompare environment. Two places:
#   VERCEL (Project → Settings → Environment Variables, Production + Preview):
#     everything under "Vercel" — read when pages are built.
#   GITHUB (repo → Settings → Secrets and variables → Actions → Secrets):
#     everything under "GitHub Actions" — read by the daily price import.
# Public data has no database: it is committed to the repo. Private feedback
# uses one small table in one free Neon project (DATABASE_URL below).

# ============================== Vercel ==============================
# Canonical site URL, no trailing slash (sitemap, canonical tags, JSON-LD).
# Optional: the canonical address is built in (https://www.camcompare.app, src/lib/site.ts).
# Set only for a staging domain; a *.vercel.app value is ignored.
NEXT_PUBLIC_SITE_URL=

# Feedback (the form and the owner's /admin page). DATABASE_URL: the POOLED
# connection string of a free Neon project named camcompare, used ONLY for
# private feedback (the table is created on first use). Unset: the form says
# feedback isn't connected yet and /api/feedback answers 503.
DATABASE_URL=
# ADMIN_KEY: a long random string (32+ letters and digits; under 16 never
# matches). The owner's admin link is https://<site>/admin/<ADMIN_KEY>.
# Anyone with the link can read all feedback, so keep it private.
ADMIN_KEY=

# Price alerts by email ("Track this price"; src/lib/alerts.ts). They use the
# same DATABASE_URL (table price_alerts, created on first use) and send
# through Resend (resend.com, free tier: 100 emails a day, 3,000 a month).
# RESEND_API_KEY: a Resend API key with sending access, for the verified
# camcompare.app domain. Unset: the form says alerts aren't switched on yet.
RESEND_API_KEY=
# Sender. Optional; default "CamCompare <alerts@camcompare.app>". Its domain
# must be the one verified in Resend.
ALERTS_FROM_EMAIL=

# Amazon Associates: one store id per marketplace (each is its own Associates account).
AMAZON_TAG_US=
AMAZON_TAG_UK=
AMAZON_TAG_DE=
AMAZON_TAG_AU=
AMAZON_TAG_SG=

# Amazon Creators API, one credential per region (Associates Central → Tools →
# Creators API; opens after 10 qualifying sales in 30 days). Needed HERE too:
# each build fetches Amazon's prices fresh, because they may not be stored.
AMAZON_CREATORS_NA_CLIENT_ID=
AMAZON_CREATORS_NA_CLIENT_SECRET=
AMAZON_CREATORS_EU_CLIENT_ID=
AMAZON_CREATORS_EU_CLIENT_SECRET=
AMAZON_CREATORS_FE_CLIENT_ID=
AMAZON_CREATORS_FE_CLIENT_SECRET=

# eBay Partner Network campaign id (make a CamCompare campaign, separate from RiftCompare's).
EBAY_AFFILIATE_CAMPAIGN=

# Deep-link templates, one per retailer programme (formats: docs/retailers.md).
# {url} = the product URL, {subid} = our click reference. B&H style: "&BI=…&KBID=…".
# DEEPLINKS-START
AFFILIATE_DEEPLINK_BH=  # B&H Photo (US, Retailer's own programme)
AFFILIATE_DEEPLINK_ADORAMA=  # Adorama (US, Impact)
AFFILIATE_DEEPLINK_BESTBUY=  # Best Buy (US, Impact)
AFFILIATE_DEEPLINK_WALMART=  # Walmart (US, Impact)
AFFILIATE_DEEPLINK_ABT=  # Abt (US, CJ)
AFFILIATE_DEEPLINK_MOMENT=  # Moment (US, Impact)
AFFILIATE_DEEPLINK_CAMERA_WEST=  # Camera West (US, Retailer's own programme)
AFFILIATE_DEEPLINK_MPB=  # MPB (US, Partnerize)
AFFILIATE_DEEPLINK_KEH=  # KEH (US, Awin)
AFFILIATE_DEEPLINK_WEX=  # Wex Photo Video (UK, Impact)
AFFILIATE_DEEPLINK_PARK_CAMERAS=  # Park Cameras (UK, Rakuten Advertising)
AFFILIATE_DEEPLINK_JESSOPS=  # Jessops (UK, Partnerize)
AFFILIATE_DEEPLINK_CLIFTON_CAMERAS=  # Clifton Cameras (UK, Awin)
AFFILIATE_DEEPLINK_CAMERAWORLD=  # CameraWorld (UK, Rakuten Advertising)
AFFILIATE_DEEPLINK_LCE=  # London Camera Exchange (UK, Webgains)
AFFILIATE_DEEPLINK_CURRYS=  # Currys (UK, Awin)
AFFILIATE_DEEPLINK_MPB_UK=  # MPB (UK, Partnerize)
AFFILIATE_DEEPLINK_CALUMET_DE=  # Calumet (EU, Awin)
AFFILIATE_DEEPLINK_FOTO_ERHARDT=  # Foto Erhardt (EU, Webgains)
AFFILIATE_DEEPLINK_CYBERPORT=  # Cyberport (EU, Retailer's own programme)
AFFILIATE_DEEPLINK_MEDIAMARKT_DE=  # MediaMarkt (EU, Retailer's own programme)
AFFILIATE_DEEPLINK_COOLBLUE=  # Coolblue (EU, Awin)
AFFILIATE_DEEPLINK_MPB_EU=  # MPB (EU, Partnerize)
AFFILIATE_DEEPLINK_CAMERA_HOUSE=  # Camera House (AU, Commission Factory)
AFFILIATE_DEEPLINK_CAMERAPRO=  # CameraPro (AU, Commission Factory)
AFFILIATE_DEEPLINK_JBHIFI=  # JB Hi-Fi (AU, Partnerize)
AFFILIATE_DEEPLINK_LAZADA_SG=  # Lazada (SG, Lazada Affiliate)
AFFILIATE_DEEPLINK_SHOPEE_SG=  # Shopee (SG, Shopee Affiliate)
# DEEPLINKS-END

# Display ads (leave empty until AdSense approves the site).
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_PRODUCT=
NEXT_PUBLIC_ADSENSE_SLOT_LISTING=
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE=
ADSENSE_PUBLISHER_ID=

# Site-ownership codes (meta-tag method). Paste only the code, not the tag.
GOOGLE_SITE_VERIFICATION=   # Search Console → HTML tag → content="…"
BING_SITE_VERIFICATION=     # Bing Webmaster Tools → meta tag msvalidate.01
IMPACT_SITE_VERIFICATION=   # Impact → Settings → Properties → verification code

# ========================== GitHub Actions ==========================
# eBay Browse API keys (developer.ebay.com). Until set, eBay shows a tagged search link.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# EBAY_AFFILIATE_CAMPAIGN (same value as on Vercel)

# AMAZON_CREATORS_* and AMAZON_TAG_* (same values as on Vercel): the daily
# import uses them to find each product's ASIN.

# Price alerts: scripts/check-alerts.ts runs after each import and emails
# alerts whose price dropped. Same values as on Vercel; unset, the step skips.
# DATABASE_URL (the same pooled Neon connection string as on Vercel)
# RESEND_API_KEY
# ALERTS_FROM_EMAIL (optional)

# Best Buy Products API key (developer.bestbuy.com, free).
BESTBUY_API_KEY=

# Product feed URLs from each affiliate network (CSV/TSV/Google XML, .gz ok).
# FEEDS-START
FEED_URL_BH=  # B&H Photo (US)
FEED_URL_ADORAMA=  # Adorama (US)
FEED_URL_WALMART=  # Walmart (US)
FEED_URL_ABT=  # Abt (US)
FEED_URL_MPB=  # MPB (US)
FEED_URL_KEH=  # KEH (US)
FEED_URL_WEX=  # Wex Photo Video (UK)
FEED_URL_PARK_CAMERAS=  # Park Cameras (UK)
FEED_URL_JESSOPS=  # Jessops (UK)
FEED_URL_CLIFTON_CAMERAS=  # Clifton Cameras (UK)
FEED_URL_CAMERAWORLD=  # CameraWorld (UK)
FEED_URL_LCE=  # London Camera Exchange (UK)
FEED_URL_CURRYS=  # Currys (UK)
FEED_URL_MPB_UK=  # MPB (UK)
FEED_URL_CALUMET_DE=  # Calumet (EU)
FEED_URL_FOTO_ERHARDT=  # Foto Erhardt (EU)
FEED_URL_CYBERPORT=  # Cyberport (EU)
FEED_URL_MEDIAMARKT_DE=  # MediaMarkt (EU)
FEED_URL_COOLBLUE=  # Coolblue (EU)
FEED_URL_MPB_EU=  # MPB (EU)
FEED_URL_CAMERA_HOUSE=  # Camera House (AU)
FEED_URL_CAMERAPRO=  # CameraPro (AU)
FEED_URL_JBHIFI=  # JB Hi-Fi (AU)
# FEEDS-END

# Optional: more Openverse image searches a day (thumbnail script).
OPENVERSE_TOKEN=
